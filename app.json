{
  "expo": {
    "name": "SnapBill",
    "slug": "snapbill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6F8",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapbill.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.snapbill.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2545"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "ksphanindra",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3F6F8"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e51cbb7a-2dcf-4402-93de-59fde4117c7f"
      }
    }
  }
}
